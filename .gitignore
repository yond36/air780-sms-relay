# Per-device credentials and site-specific configuration must stay private.
/device_auth.lua
/device/device_auth.lua
/config.lua
/device/config.lua
/server/wrangler.toml
/server/.dev.vars
/server/.dev.vars.*
!/server/.dev.vars.example
/.env
/.env.*
